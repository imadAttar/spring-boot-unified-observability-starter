{
  "title": "Spring Boot - Alerts Overview",
  "tags": [
    "spring-boot",
    "alerts",
    "observability",
    "sre"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Active Alerts Count",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "count(ALERTS{alertstate=\"firing\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background"
      }
    },
    {
      "id": 2,
      "title": "Alerts by Severity",
      "type": "piechart",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "count by (severity) (ALERTS{alertstate=\"firing\"})"
        }
      ]
    },
    {
      "id": 3,
      "title": "Alert Timeline (24h)",
      "type": "graph",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "count by (alertname) (ALERTS{alertstate=\"firing\"})",
          "legendFormat": "{{alertname}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active Alerts Details",
      "type": "table",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "ALERTS{alertstate=\"firing\"}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "alertstate": true
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "service": 2,
              "environment": 3
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Most Frequent Alerts (7 days)",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "expr": "topk(10, count_over_time(ALERTS{alertstate=\"firing\"}[7d]))",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Service Health Heatmap",
      "type": "heatmap",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "expr": "up",
          "format": "heatmap"
        }
      ],
      "dataFormat": "tsbuckets"
    }
  ]
}